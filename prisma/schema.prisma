generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Generation {
  id          String   @id @default(uuid())
  type        String
  status      String   @default("PENDING")
  prompt      String
  webhook_url String?
  output_url  String?
  createdAt   DateTime @default(now())
}

